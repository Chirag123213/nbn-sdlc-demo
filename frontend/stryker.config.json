{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.config.ts" },
  "mutate": [
    "src/actions/faults.actions.ts",
    "src/lib/validations/faults.ts",
    "src/features/faults/**/*.ts",
    "src/features/faults/**/*.tsx"
  ],
  "reporters": ["clear-text", "json", "html"],
  "jsonReporter": { "fileName": "reports/mutation/fault-reporting.json" },
  "htmlReporter": { "fileName": "reports/mutation/fault-reporting.html" },
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "thresholds": { "break": 0 }
}
